# Required to run GreyCore
TOKEN=
CLIENT_ID=

# Optional: absolute path to the shared GreyCore SQLite database.
# Leave empty to use ./data/greycore.sqlite in this project.
GREYCORE_DATABASE_PATH=

# Optional help link shown in welcome message and /aide
GREYCORE_HELP_URL=

# Required only by the command-cleanup script
GUILD_ID=

# Optional backup settings
GREYCORE_BACKUP_INTERVAL_HOURS=
GREYCORE_BACKUP_MAX_FILES=

# Legal/privacy information shown by /confidentialite politique
GREYCORE_LEGAL_OPERATOR=Greyline Chapter
GREYCORE_PRIVACY_EMAIL=contact@greyline.fr

# Optional GreyFate integration (same strong secret in both applications)
GREYFATE_INTEGRATION_ENABLED=false
GREYFATE_SHARED_SECRET=
GREYCORE_FATE_HOST=127.0.0.1
GREYCORE_FATE_PORT=8790
GREYFATE_CALLBACK_URL=http://127.0.0.1:8791/integrations/greycore/events

# Optional read-only operational connector to a local GreyOS instance.
# Keep the origin on loopback. The secret must contain at least 32 random bytes
# encoded as base64url and must match the GreyOS connector registration.
GREYCORE_GREYOS_CONNECTOR_ENABLED=false
GREYCORE_GREYOS_CONNECTOR_ORIGIN=http://127.0.0.1:3001
GREYCORE_GREYOS_CONNECTOR_INSTALLATION_ID=greycore-production-main
GREYCORE_GREYOS_CONNECTOR_KEY_ID=
GREYCORE_GREYOS_CONNECTOR_SECRET=
GREYCORE_GREYOS_CONNECTOR_INTERVAL_MS=120000
